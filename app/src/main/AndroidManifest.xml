<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 8-9 (API 26-28) için Depolama İzinleri -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Android 10+ (API 29+) için Tüm Dosyalara Erişim -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Yüklü uygulamaları listeleyebilmek için (Cache temizliği) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Arka plan işleri için (WorkManager) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Titreşim için (Haptic Feedback) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Xiaomi benzeri bellek temizliği -->

    <!-- Kullanılmayan uygulamalar: yalnızca kullanıcı ayarlardan verirse -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Biyometrik kimlik doğrulama için -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- GitHub Releases güncelleme -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Widget için gerekli özellikler -->
    <uses-feature android:name="android.software.app_widgets" android:required="false" />

    <!-- Biyometrik donanım -->
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />
    <uses-feature android:name="android.hardware.biometrics" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:name=".MakayCleanerApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.App.Starting"
        android:requestLegacyExternalStorage="true"
        android:banner="@drawable/tv_banner"
        android:logo="@mipmap/ic_launcher"
        tools:targetApi="36">

        <!-- Ana Aktivite -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.App.Starting"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:banner="@drawable/tv_banner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Widget Provider -->
        <receiver
            android:name=".widget.CleanerWidgetProvider"
            android:exported="true"
            android:label="Makay Cleaner Widget">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.makay.cleaner.WIDGET_QUICK_CLEAN" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <receiver
            android:name=".worker.GoodNightReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.makay.cleaner.GOOD_NIGHT_REMIND" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
