<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ana Tema -->
    <style name="Theme.MakayCleaner" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash Screen Tema (Turkuaz - İkonla Uyumlu) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#4ECDC4</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.MakayCleaner</item>
    </style>
</resources>